<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:enableOnBackInvokedCallback="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:theme="@style/Theme.App.Starting"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
      <!-- 카톡 초대 링크 https://<host>/c#123456 → MainActivity(번호는 URL 조각, JS 가 Linking 으로 읽고 APP_LINK_HOST 와 대조).
           도메인 미정이면 비활성(appLinksEnabled=false): 비활성 alias 는 인텐트 해석에서 빠진다. 단 도메인 검증 목록에는
           applinks.invalid 가 올라가 실패(1024)로 남는다 — 무해(에뮬레이터 API 35 확인, 스파이크 문서 3절).
           host 원본은 app/env/<flavor>.env 의 APP_LINK_HOST(로컬 확인은 debug 한정 -PappLinkHostDebug). 스파이크: docs/team/spikes/2026-11-17-install-referrer-applinks.md -->
      <activity-alias
        android:name=".InviteLinkActivity"
        android:targetActivity=".MainActivity"
        android:enabled="${appLinksEnabled}"
        android:exported="true">
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="${appLinkHost}" android:path="/c" />
        </intent-filter>
      </activity-alias>
      <!-- 카카오톡이 없을 때 카카오계정(웹) 로그인에서 앱으로 돌아오는 화면. scheme 은 kakao{네이티브 앱 키}(공개 값) -->
      <activity
        android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:host="oauth" android:scheme="@string/kakao_scheme" />
        </intent-filter>
      </activity>
    </application>
</manifest>
