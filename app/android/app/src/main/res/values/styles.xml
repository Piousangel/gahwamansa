<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- 라이트 고정: 다크 모드에서 대화상자·입력칸만 어두워지는 문제 방지. 상태 표시줄 아이콘 어둡게(종이색 위) -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/paper</item>
    </style>

    <!-- 시스템 스플래시(SPL_A): 종이색 바탕 + 심볼만. 다크 모드도 고정. JS 첫 화면이 그려질 때까지(최대 3초) 유지 -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_symbol</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
