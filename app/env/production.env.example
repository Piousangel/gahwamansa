# production(실사용자) 환경의 "공개 값" 예시. 실제 값은 이 파일을 app/env/production.env 로 복사해 채운다.
# production.env 는 지금 gitignore(공개 값이라 커밋해도 되지만, 새 Pro 프로젝트가 생기기 전 실수 방지).
# 절대 넣지 않는 것: DB 비밀번호, service_role·secret 키(sb_secret_...), 카카오·구글 Client Secret, FCM 서비스 계정.
# production.env 가 없으면 Gradle 은 이 예시 값으로 빌드하고 경고한다(그 앱은 서버에 붙지 못함).
# scripts/build-production.sh 는 production.env 가 없으면 빌드하지 않는다.

APP_ENV=production
API_MODE=real

# 새 Supabase Pro 프로젝트(서울). 대시보드 Project Settings > API 에서 확인
SUPABASE_PROJECT_REF=your-production-ref
SUPABASE_URL=https://your-production-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# 카카오 네이티브 앱 키(앱 1653853의 기존 키 = production)
KAKAO_NATIVE_APP_KEY=1cd831e4a2589fb6a4f756a6553c0681

# 구글 "웹" 클라이언트 ID(production 용)
GOOGLE_WEB_CLIENT_ID=818070207841-o75t4oegtkuoliv37mkf78hb1ivesbbp.apps.googleusercontent.com

# 선택: 공유 메시지 링크 주소(https://<도메인>/c). 도메인 미정이면 비워 두거나 줄을 지운다 → 메시지에서 링크 줄이 빠진다
# SHARE_LINK_BASE=
