# 스테이징(테스트) 환경의 "공개 값"만. 앱 안에 그대로 들어가므로 누구나 볼 수 있는 값이어야 한다.
# 절대 넣지 않는 것: DB 비밀번호, service_role·secret 키(sb_secret_...), 카카오·구글 Client Secret, FCM 서비스 계정.
# (빌드는 이름에 SECRET·SERVICE_ROLE·PASSWORD 가 들어간 키나 sb_secret_ 로 시작하는 값을 보면 실패한다)
# 빌드 때 Gradle 이 이 파일을 읽어 BuildConfig·리소스·src/lib/env.generated.ts 로 넣는다. 설계: docs/plans/09-environments.md

APP_ENV=staging
API_MODE=real

# Supabase: 현재 원격(eigocuecmaapxnmhttwj, 서울) = staging (DECISIONS 2026-11-17 운영 결정)
SUPABASE_PROJECT_REF=eigocuecmaapxnmhttwj
SUPABASE_URL=https://eigocuecmaapxnmhttwj.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_cvckcrbP-GRiDuQLk9XAvQ_8ymxPnSD

# 카카오 네이티브 앱 키(같은 앱 1653853). staging 전용 키를 추가할 예정 — 지금은 production 과 같은 값.
# 키를 바꾸면 카카오 콘솔에서 그 키에 .staging 패키지·키 해시를 등록해야 로그인이 된다.
KAKAO_NATIVE_APP_KEY=1cd831e4a2589fb6a4f756a6553c0681

# 구글 "웹" 클라이언트 ID(ID 토큰 aud). staging 용 웹 클라이언트를 새로 만들 예정 — 지금은 기존 값.
GOOGLE_WEB_CLIENT_ID=818070207841-o75t4oegtkuoliv37mkf78hb1ivesbbp.apps.googleusercontent.com


# 앱 정보(AU-07, 선택·공개 값). 비우면 설정 화면에서 그 행이 '[설정 필요]'로 보이고 빌드가 경고한다. production release 는 비어 있으면 빌드 실패(G-INT).
# 값은 사용자 몫 US-03(도메인·게시 URL)·US-04(사업자 정보). 형식: https URL만, 사업자등록번호 000-00-00000, 글자 80자 안(따옴표·꺾쇠 없이)
# TERMS_URL=https://<도메인>/terms.html
# PRIVACY_URL=https://<도메인>/privacy.html
# CONTACT_EMAIL=<문의 메일>
# BIZ_NAME=<상호>
# BIZ_CEO=<대표>
# BIZ_REG_NO=000-00-00000
# BIZ_ADDRESS=<주소>
